{
  "manifest_version": 3,
  "name": "LeetHub: LeetCode to GitHub Sync",
  "short_name": "LeetHub",
  "description": "Automatically save accepted LeetCode solutions and problem descriptions to GitHub. Organize your coding practice in your own repo.",
  "version": "1.0.10",
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "index.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png",
    "32": "assets/icon-32.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
